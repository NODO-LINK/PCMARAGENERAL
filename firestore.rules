rules_version = '2';

/**
 * firestore.rules
 * -----------------------------------------------------------------------
 * Reglas de seguridad para el Sistema Integral de Gestión Operativa de
 * Protección Civil.
 *
 * Principios de RBAC aplicados (reflejan exactamente lo implementado en la
 * interfaz — js/data.js, js/auth.js):
 *   - OPERADOR: puede crear y leer registros operativos. NO puede editar
 *     ni eliminar registros históricos ya guardados.
 *   - ADMINISTRADOR: control total (crear, leer, editar, eliminar) sobre
 *     todos los registros y catálogos del sistema.
 *   - HIDRO: rol restringido para personal externo al que solo se le
 *     entrega el módulo de Hidrometeorología (Río Limón, página aparte
 *     rio-limon.html). NO puede leer ni escribir ningún otro módulo — la
 *     restricción está aplicada aquí, no solo ocultando botones en la UI,
 *     para que sea real aunque inicie sesión con la app completa.
 *   - DEPARTAMENTO (dep_emergencias, dep_guardias, dep_combustible,
 *     dep_educacion, dep_inspeccion, dep_inventario, hidro): un trabajador
 *     con acceso a uno o varios departamentos (rol 'departamentos' + lista
 *     `departamentos` en su perfil) que SOLO puede leer y crear en las
 *     colecciones de sus departamentos (más el catálogo/inventario que ese módulo necesita);
 *     igual que el Operador, no edita ni elimina registros guardados. Debe
 *     coincidir con DEPARTAMENTOS en js/config.js.
 *   - Los catálogos maestros (instituciones, categorías de insumos,
 *     insumos) solo pueden ser creados/editados/eliminados por el
 *     administrador; cualquier Operador/Administrador puede leerlos para
 *     poblar los <select> de los formularios operativos (el rol Hidro no).
 *   - Toda creación debe declarar `createdBy` igual al uid autenticado,
 *     reforzando la trazabilidad obligatoria de la aplicación.
 * -----------------------------------------------------------------------
 */
service cloud.firestore {
  match /databases/{database}/documents {

    /* -------------------------- Helpers de rol ------------------------- */
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function isKnownUser() {
      return isSignedIn() && userDoc().data != null && userDoc().data.activo != false;
    }

    function isAdmin() {
      return isSignedIn() && userDoc().data.rol == 'admin' && userDoc().data.activo != false;
    }

    function isOperador() {
      return isSignedIn() && userDoc().data.rol == 'operador' && userDoc().data.activo != false;
    }

    // Acceso a Hidrometeorología: rol 'hidro' (un solo departamento) o el rol
    // genérico 'departamentos' que incluya 'hidro' en su lista.
    function isHidroOperador() {
      return hasAnyRole(['hidro']);
    }

    // Rol de departamento: true si el usuario activo tiene alguno de los
    // roles de la lista (ej. ['dep_emergencias', 'dep_inventario']).
    //  - Rol de un solo departamento: su valor está en la lista (rol 'dep_guardias').
    //  - Rol genérico 'departamentos': el perfil trae `departamentos`, una lista
    //    (de 1 a 3 en la interfaz) y basta con que alguno esté en `roles`.
    function hasAnyRole(roles) {
      return isSignedIn() && userDoc().data.activo != false && (
        userDoc().data.rol in roles ||
        (userDoc().data.rol == 'departamentos' && userDoc().data.departamentos.hasAny(roles))
      );
    }

    // Leer / crear en un módulo: Administrador, Operador o alguno de los
    // roles de departamento que le corresponden a ese módulo.
    function canReadFor(roles) {
      return isAdmin() || isOperador() || hasAnyRole(roles);
    }
    function canCreateFor(roles) {
      return canReadFor(roles) && isOwnCreation();
    }

    function isOwnCreation() {
      return request.resource.data.createdBy == request.auth.uid;
    }

    // Reglas comunes a todos los módulos operativos de tipo
    // "formulario + historial" (Pacientes, Traslados, Fallecidos,
    // Guardias, Combustible, Educación): Operador y Administrador pueden
    // leer y crear declarando su propia autoría; solo el administrador
    // puede editar o eliminar. El rol Hidro queda deliberadamente FUERA de
    // esta función (no es isKnownUser()/isSignedIn() genérico) para que no
    // tenga acceso a ningún módulo fuera de Hidrometeorología.
    function canReadOperational() {
      return isAdmin() || isOperador();
    }
    function canCreateOperational() {
      return (isAdmin() || isOperador()) && isOwnCreation();
    }
    function canWriteOperational() {
      return isAdmin();
    }

    /* ------------------------------ usuarios ---------------------------- */
    match /usuarios/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      // Solo un administrador crea perfiles (panel de Usuarios). Antes un
      // usuario sin perfil podía crear el suyo con el rol que quisiera —
      // incluido admin — lo que dejaba entrar a cualquiera que lograra
      // crear una cuenta de Firebase Auth.
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /* --------------- Registros operativos (crear/leer todos, ------------ */
    /* --------------- editar/eliminar solo administrador) ---------------- */
    match /pacientes/{docId} {
      allow read: if canReadFor(['dep_emergencias']);
      allow create: if canCreateFor(['dep_emergencias']);
      allow update, delete: if canWriteOperational();
    }
    match /traslados/{docId} {
      allow read: if canReadFor(['dep_emergencias']);
      allow create: if canCreateFor(['dep_emergencias']);
      allow update, delete: if canWriteOperational();
    }
    match /fallecidos/{docId} {
      allow read: if canReadFor(['dep_emergencias']);
      allow create: if canCreateFor(['dep_emergencias']);
      allow update, delete: if canWriteOperational();
    }
    match /guardias/{docId} {
      allow read: if canReadFor(['dep_guardias']);
      allow create: if canCreateFor(['dep_guardias']);
      allow update, delete: if canWriteOperational();
    }
    match /despachosCombustible/{docId} {
      allow read: if canReadFor(['dep_combustible']);
      allow create: if canCreateFor(['dep_combustible']);
      allow update, delete: if canWriteOperational();
    }
    match /educacion/{docId} {
      allow read: if canReadFor(['dep_educacion']);
      allow create: if canCreateFor(['dep_educacion']);
      allow update, delete: if canWriteOperational();
    }
    match /gestionRiesgoInspeccion/{docId} {
      allow read: if canReadFor(['dep_inspeccion']);
      allow create: if canCreateFor(['dep_inspeccion']);
      allow update, delete: if canWriteOperational();
    }
    match /cierresDiarios/{docId} {
      // "Registrable": cualquier usuario activo puede generar un cierre;
      // es un documento de cierre/trazabilidad, por lo que no se edita una
      // vez creado (solo el administrador puede eliminarlo si fue un
      // error).
      allow read: if canReadOperational();
      allow create: if canCreateOperational();
      allow update: if false;
      allow delete: if canWriteOperational();
    }
    match /hidroLecturas/{docId} {
      // Único módulo accesible también para el rol Hidro.
      allow read: if isAdmin() || isOperador() || isHidroOperador();
      allow create: if (isAdmin() || isOperador() || isHidroOperador()) && isOwnCreation();
      // Serie instrumental: no se edita una vez guardada (no se ofrece
      // edición individual desde la UI). Eliminar sí está permitido: el
      // administrador puede borrar cualquier lectura (ej. para corregir
      // importaciones masivas erróneas, "vaciar historial" antes de
      // reimportar); el rol Hidro solo puede borrar las lecturas que ÉL
      // MISMO cargó (se corrige sus propios errores de carga, sin poder
      // tocar lo que otro haya registrado).
      allow update: if false;
      allow delete: if isAdmin() || (isHidroOperador() && resource.data.createdBy == request.auth.uid);
    }

    /* --------------- Hidrometeorología: catálogo de ríos ---------------- */
    // Fluviometría: cada río (Limón, Guasare, ...) con sus propios umbrales
    // de alerta. Solo el administrador los crea/edita; cualquiera con
    // acceso a Hidrometeorología (incluido el rol Hidro) puede leerlos
    // para poblar el selector de río.
    match /rios/{docId} {
      allow read: if isAdmin() || isOperador() || isHidroOperador();
      allow create, update, delete: if isAdmin();
    }

    /* ----------- Hidrometeorología: Pluviometría (independiente) -------- */
    match /estacionesPluviometricas/{docId} {
      allow read: if isAdmin() || isOperador() || isHidroOperador();
      allow create, update, delete: if isAdmin();
    }
    match /pluviometriaLecturas/{docId} {
      allow read: if isAdmin() || isOperador() || isHidroOperador();
      allow create: if (isAdmin() || isOperador() || isHidroOperador()) && isOwnCreation();
      allow update: if false;
      allow delete: if isAdmin() || (isHidroOperador() && resource.data.createdBy == request.auth.uid);
    }

    /* ------------------------- Catálogos maestros ------------------------ */
    match /instituciones/{docId} {
      allow read: if canReadFor(['dep_emergencias', 'dep_combustible']);
      allow create, update, delete: if isAdmin();
    }
    match /categoriasInsumos/{docId} {
      allow read: if canReadFor(['dep_emergencias', 'dep_inventario']);
      allow create, update, delete: if isAdmin();
    }
    match /insumos/{docId} {
      allow read: if canReadFor(['dep_emergencias', 'dep_inventario']);
      allow create, update, delete: if isAdmin();
    }

    /* --------------------- Inventario: existencias ------------------------ */
    // Las existencias por almacén se actualizan mediante transacciones al
    // registrar entradas/transferencias; Operador o Administrador pueden
    // generar esos movimientos, pero solo el administrador puede alterar
    // manualmente el nivel mínimo crítico o eliminar el documento.
    match /insumoStock/{docId} {
      allow read: if canReadFor(['dep_emergencias', 'dep_inventario']);
      // Emergencias también descuenta existencias (insumos usados en la
      // lista diaria de pacientes), por eso puede crear/actualizar aquí.
      allow create, update: if canReadFor(['dep_emergencias', 'dep_inventario']);
      allow delete: if isAdmin();
    }

    match /entradasInventario/{docId} {
      allow read: if canReadFor(['dep_inventario']);
      allow create: if canCreateFor(['dep_inventario']);
      // Editar o eliminar (con reversión/reajuste de insumoStock) es solo
      // para el administrador; el operador únicamente crea y consulta.
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /transferenciasInventario/{docId} {
      allow read: if canReadFor(['dep_inventario']);
      allow create: if canCreateFor(['dep_inventario']);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /debitosInventario/{docId} {
      allow read: if canReadFor(['dep_emergencias', 'dep_inventario']);
      allow create: if canCreateFor(['dep_emergencias', 'dep_inventario']);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /* ------------------------------ Config -------------------------------- */
    match /config/{docId} {
      // El rol Hidro solo necesita leer los umbrales de alerta de su propio
      // módulo (config/hidrometeorologia), nada más de esta colección.
      allow read: if canReadOperational() || (isHidroOperador() && docId == 'hidrometeorologia');
      allow write: if isAdmin();
    }
  }
}
